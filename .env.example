# Vertex AI (auth: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini 3.x is served only from the global endpoint
GOOGLE_CLOUD_LOCATION=global
# Service-account key file (keep it outside the repo), or leave unset to use gcloud application-default login.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/key.json
# Three different models so nothing grades its own output (critic: short tasks, thinking off by default):
#   LLM_MODEL writes answers, CRITIC_MODEL rewrites searches and checks answers, JUDGE_MODEL grades them in eval.py.
# Names starting with "claude" go through Claude on Vertex (enable it in Model Garden first).
LLM_MODEL=gemini-2.5-flash
# If LLM_MODEL stalls for PRIMARY_TIMEOUT seconds, FALLBACK_MODEL writes the answer instead (unset to disable).
FALLBACK_MODEL=gemini-2.5-flash-lite
PRIMARY_TIMEOUT=15
CRITIC_MODEL=gemini-2.5-flash-lite
CRITIC_THINKING_BUDGET=0
JUDGE_MODEL=gemini-2.5-flash-lite
CLAUDE_LOCATION=us-east5
EMBED_MODEL=text-embedding-005
# region nearest your server: embeddings from Mumbai took 0.19s vs 1.3s from us-central1 (same vectors)
EMBED_LOCATION=asia-south1
MAX_ATTEMPTS=2

# Langfuse tracing (optional; free cloud tier at https://cloud.langfuse.com). Leave blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Scanned PDF pages (no text layer) are transcribed by this vision model, about $0.005 per page; "off" uses Docling OCR.
SCAN_MODEL=gemini-2.5-flash
# Hard spend caps (USD). Chat and scanned-page reading stop for the month once MONTHLY_BUDGET_USD is spent
# (tracked in spend.json); each eval run stops at EVAL_BUDGET_USD. At most SCAN_MAX_PAGES pages per document
# go to SCAN_MODEL; the rest use Docling OCR (free).
MONTHLY_BUDGET_USD=5
EVAL_BUDGET_USD=1
SCAN_MAX_PAGES=10
# Public deployment: shared password for the whole site (HTTP Basic auth; serve behind TLS), and a Qdrant
# server so several app processes can share one index (docker-compose sets QDRANT_URL).
# APP_PASSWORD=
# QDRANT_URL=http://localhost:6333
